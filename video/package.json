{
  "name": "furfolio-promo",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "studio": "remotion studio src/index.ts --port=3300 --no-open",
    "render": "remotion render src/index.ts Furfolio-Promo ../outputs/promo-video/furfolio-promo-4x3.mp4 --codec=h264 --crf=17 --concurrency=4",
    "render:v2": "remotion render src/index.ts Furfolio-Promo-V2 ../outputs/promo-video/furfolio-promo-v2-4x3-60fps.mp4 --codec=h264 --crf=17 --concurrency=4",
    "render:v3": "remotion render src/index.ts Furfolio-Promo-V3 ../outputs/promo-video/furfolio-promo-v3-4x3-60fps.mp4 --codec=h264 --crf=17 --concurrency=4",
    "check": "tsc --noEmit"
  },
  "dependencies": {
    "@remotion/cli": "4.0.534",
    "@remotion/fonts": "4.0.534",
    "@remotion/media": "4.0.534",
    "@remotion/transitions": "4.0.534",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "remotion": "4.0.534"
  },
  "devDependencies": {
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.3",
    "typescript": "5.9.3"
  }
}
